{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@core/*": [
        "./src/core/*"
      ]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/api.d.ts",
    "src/core/**/*.ts"
  ],
  "exclude": [
    "src/core/executor.ts",
    "src/core/**/*.test.ts"
  ]
}
