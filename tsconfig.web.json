{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@core/*": [
        "./src/core/*"
      ]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/api.d.ts",
    "src/core/**/*.ts"
  ],
  "exclude": [
    "src/core/executor.ts",
    "src/core/run.ts",
    "src/core/templates.ts",
    "src/core/responseStore.ts",
    "src/core/sandbox.ts",
    "src/core/sandbox-prelude.ts",
    "src/core/awsv4.ts",
    "src/core/digest.ts",
    "src/core/oauth2.ts",
    "src/core/sandbox-libs.ts",
    "src/core/mock.ts",
    "src/core/realtime.ts",
    "src/core/grpc.ts",
    "src/core/**/*.test.ts"
  ]
}
